# ============================================================
# PayPilot Backend — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=paypilot
ENVIRONMENT=production   # development | production

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=https://your-frontend-domain.vercel.app,https://your-custom-domain.com

# --- PayPal (Sandbox credentials — replace with LIVE for production) ---
PAYPAL_MODE=sandbox                              # sandbox | live
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com  # https://api-m.paypal.com for live
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID         # Register in PayPal Developer Dashboard

# --- AI Provider (configure ONE of the following) ---
AI_PROVIDER=gemini        # gemini | openai
AI_MODEL=gemini-1.5-flash # gemini-1.5-flash | gpt-4o-mini | gpt-4o
GEMINI_API_KEY=           # Get from https://aistudio.google.com/app/apikey
OPENAI_API_KEY=           # Get from https://platform.openai.com/api-keys

# --- AI Model Parameters ---
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1500

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --- Email Notifications (optional — truthfulness: leave blank if not configured) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_EMAIL_FROM=notifications@paypilot.in
EMAIL_DELIVERY_ENABLED=false

# --- Business Defaults ---
DEFAULT_CURRENCY=INR
DEFAULT_TAX_RATE=18.0
UPCOMING_DUE_WINDOW_DAYS=3
REMINDER_DEDUP_WINDOW_DAYS=3
